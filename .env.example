# Copied to /opt/handahana/.env on the droplet (Handahana only — not LUMS).
NEXT_PUBLIC_BASE_PATH=/hadahana
HANDAHANA_BIND_ADDRESS=127.0.0.1
HANDAHANA_PORT=4132
HANDAHANA_IMAGE=ghcr.io/OWNER/hadahana:latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional public browser analytics (build-time; disabled without consent/keys)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only LUMS profiles. No LUMS service key is needed; user JWTs stay in an encrypted cookie.
LUMS_API_URL=https://lums.ervanta.com/api
# At least 32 random characters; never NEXT_PUBLIC_ or a build argument.
SESSION_SECRET=
