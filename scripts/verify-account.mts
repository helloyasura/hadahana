import assert from 'node:assert/strict';
import { randomBytes } from 'node:crypto';
import { configured, seal, unseal } from '../src/lib/account/crypto';
const before = { SESSION_SECRET: process.env.SESSION_SECRET, LUMS_API_URL: process.env.LUMS_API_URL };
process.env.SESSION_SECRET = randomBytes(48).toString('hex');
process.env.LUMS_API_URL = 'https://example.test/api';
assert.equal(configured(), true);
const value = { token: 'test-token', birth: { date: '1995-06-15' } };
const encrypted = seal(value, 'pending');
assert(!encrypted.includes('test-token'));
assert.deepEqual(unseal(encrypted, 'pending'), value);
assert.equal(unseal(encrypted, 'session'), null, 'cookie purpose is authenticated');
assert.equal(unseal(encrypted.slice(0, -8) + 'changed!', 'pending'), null, 'tampered cookies fail closed');
assert.equal(unseal(seal(value, 'pending', -1), 'pending'), null, 'expired cookies fail closed');
process.env.SESSION_SECRET = randomBytes(48).toString('hex');
assert.equal(unseal(encrypted, 'pending'), null, 'rotation invalidates old cookies');
delete process.env.SESSION_SECRET;
assert.equal(configured(), false);
assert.equal(unseal(encrypted, 'pending'), null);
assert.throws(() => seal(value, 'session'));
for (const [k, v] of Object.entries(before)) if (v === undefined) delete process.env[k]; else process.env[k] = v;
console.log('Account crypto: encryption, purpose binding, tamper, expiry, rotation and missing configuration passed.');
