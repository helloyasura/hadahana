# Snippet for the existing ervanta.com server block (host nginx).
# Does NOT replace LUMS / GovFlow / landing configs — only adds /hadahana.
#
# Upstream Handahana (Compose project `handahana` on the droplet):
#   127.0.0.1:4132  → container :3000 with Next basePath=/hadahana
#
# Next.js (default trailingSlash:false) serves the app at /hadahana
# and redirects /hadahana/ → /hadahana. Do NOT 301 the other way.

upstream handahana_web {
    server 127.0.0.1:4132;
    keepalive 8;
}

# Inside the ervanta.com (or www.ervanta.com) server { ... } block:

location /hadahana {
    proxy_pass http://handahana_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 120s;
}

# Marketplace deep-link:
#   https://ervanta.com/hadahana
#   card launchUrl = https://ervanta.com/hadahana
